{
  "name": "barcode-app",
  "version": "1.0.0",
  "main": "server.js",
  "bin": "server.js",
  "scripts": {
    "start": "node server.js",
	"build": "pkg ."
  },
  "pkg": {
    "assets": [
      "icon.ico",
