    ],
    "outputPath": "dist"
  },
  "dependencies": {
    "bootstrap": "^5.3.8",
    "express": "^4.22.3",
    "jsbarcode": "^3.12.3",
    "lowdb": "^1.0.0",
    "systray": "^1.0.5",
    "xmldom": "^0.6.0"
  }
}
